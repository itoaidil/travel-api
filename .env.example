# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=travel_booking
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (generate random string for production)
JWT_SECRET=your-secret-key-here

# Midtrans Payment Gateway Configuration
# Daftar di: https://dashboard.midtrans.com/
# Sandbox (testing): https://dashboard.sandbox.midtrans.com/
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_SANDBOX_CLIENT_KEY

# DANA Disbursement Configuration
# Dashboard: https://dashboard.dana.id/sandbox (or production)
# Untuk withdrawal/transfer ke rekening driver
DANA_CLIENT_ID=your_dana_client_id
DANA_CLIENT_SECRET=your_dana_client_secret
DANA_API_KEY=your_dana_api_key
DANA_MERCHANT_ID=your_merchant_id
DANA_BASE_URL=https://api-sandbox.dana.id/v1
DANA_WEBHOOK_SECRET=your_webhook_secret_key

# Frontend URL (untuk callback payment)
FRONTEND_URL=http://localhost:3000

# Firebase Cloud Messaging Configuration (for push notifications)
# Option 1: Use service account JSON file (recommended for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Use environment variables (recommended for production/Railway)
# Get these from: Firebase Console > Project Settings > Service Accounts
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# Email Service Configuration (for OTP)
# Mode: 'testing' (console log only) or 'production' (send real emails)
EMAIL_MODE=testing

# Gmail SMTP Configuration (only needed in production mode)
# How to get Gmail App Password:
# 1. Go to Google Account Settings > Security
# 2. Enable 2-Step Verification
# 3. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-digit-app-password
EMAIL_FROM=PO Hantar Travel <noreply@pohantar.com>

# Feature Flags
ENABLE_PROVINCE_FEATURES=true
