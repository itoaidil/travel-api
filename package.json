{
  "name": "travel-api",
  "version": "1.0.0",
  "description": "API Server untuk Travel Booking App (Student, Driver, PO)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd franchise_admin && npm install && npm run build",
    "dev": "nodemon server.js",
    "seed:local": "node migrations/seed_initial_data.js",
    "seed:railway": "node migrations/seed_railway_data.js",
    "migrate:base": "node migrations/run_base_migrations.js",
    "import:regions": "node scripts/import_indonesia_regions.js",
    "import:regions:sql": "node scripts/import_wilayah_sql_one_shot.js"
  },
  "keywords": [
    "travel",
    "booking",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "midtrans-client": "^1.4.3",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.6.0",
    "nodemailer": "^6.10.1",
    "resend": "^6.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
